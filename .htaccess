<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # CGI/Apache frequentemente omite Authorization; repassa para o PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Evita problemas de negociação de conteúdo e listagem de diretórios
    Options +FollowSymLinks -MultiViews -Indexes

    # Forçar HTTPS se necessário (descomente se estiver em produção com SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ----------------------------------------------------------------------
    # | Rotas da API e Callbacks                                           |
    # ----------------------------------------------------------------------
    RewriteRule ^api/frontend/(.*)$ api/v1/api.php [QSA,L]
    RewriteRule ^api/v1/online_ping(\.php)?$ api/v1/online_ping.php [NC,QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/v1/(.+)$ api/v1/api.php [QSA,L]
    RewriteRule ^gold_api(.*)$ callback/game_callback.php [QSA,L]
    RewriteRule ^infinitysoft_api(.*)$ callback/game_callback.php [QSA,L]
    
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^igamewin(.*)$ callback/igamewin.php [QSA,L]
    
    RewriteRule ^ppclone(.*)$ callback/ppclone.php [QSA,L]
    RewriteRule ^drakon_api(.*)$ callback/drakon.php [QSA,L]
    RewriteRule ^playfiver/webhook(.*)$ callback/playfiver.php [QSA,L]

    # ----------------------------------------------------------------------
    # | sistema abaixo faz dowload das imagens                                             |
    # ----------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^.*\.(png|jpg|jpeg|gif|svg|webp|ico)$ missing_asset.php [QSA,L]

    # ----------------------------------------------------------------------
    # | SPA Fallback (Single Page Application)                             |
    # ----------------------------------------------------------------------
    DirectoryIndex index.php

    # CSS/JS/fontes/imagens nunca caem no SPA (evita MIME text/html)
    RewriteCond %{REQUEST_URI} \.(css|js|mjs|map|json|woff2?|ttf|otf|eot|png|jpe?g|gif|svg|ico|webp)$ [NC]
    RewriteRule ^ - [L]

    # Se o arquivo ou diretório existir, serve diretamente,
    # EXCETO se for na rota main/ (para evitar conflito com diretório físico 'main')
    RewriteCond %{REQUEST_URI} !^/main/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Caso contrário, redireciona tudo para index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ----------------------------------------------------------------------
# | Configuração de Charset                                            |
# ----------------------------------------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js .mjs
    AddType application/json .json
    AddCharset UTF-8 .js
    AddCharset UTF-8 .css
    AddCharset UTF-8 .html
    AddCharset UTF-8 .json
</IfModule>

# ----------------------------------------------------------------------
# | Configurações de Segurança e Headers                               |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    
    # Cache Control para arquivos dinâmicos
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>

    # Evita JS antigo em cache (DevTools crash / bundles do frontend)
    <FilesMatch "\.(js)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>
